# Writes build_stamp.h with the time of this build (main/CMakeLists.txt runs
# it on every build). Only rewritten when the minute changes, so a build
# with nothing new doesn't relink.
string(TIMESTAMP date "%b %d %Y")
string(TIMESTAMP time "%H:%M")
file(WRITE "${OUT}.tmp"
     "/* Generated by main/build_stamp.cmake on every build. */\n"
     "#pragma once\n"
     "#define HM_BUILD_DATE \"${date}\"\n"
     "#define HM_BUILD_TIME \"${time}\"\n")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
