# Secrets for Hubmote. Copy this file to secrets.env (gitignored), then
# remove the # in front of the lines you need and fill them in. One
# KEY=value per line, taken literally to the end of the line; wrap a value
# in double quotes to keep leading or trailing spaces.

# Optional: Wi-Fi for a freshly flashed remote. Without these the remote asks
# on its first start; either way it keeps the network once it connects, and
# Settings > Wi-Fi changes it.
#WIFI_SSID="My Router SSID"
#WIFI_PASSWORD="MyRouterPassword"

# Updates over Wi-Fi (scripts/hm-ota.ps1) and tools/devtools.py sign their
# requests with the remote's update token. A developer build makes it up the
# first time it joins Wi-Fi: copy it here from Settings > About > Update
# token (Show). It never goes into a firmware image.
#OTA_TOKEN="the token from Settings > About"
