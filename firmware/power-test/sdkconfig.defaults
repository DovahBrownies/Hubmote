CONFIG_IDF_TARGET="esp32s3"

# ESP32-S3-WROOM-1-N16R8: 16 MB QIO flash, 8 MB octal PSRAM
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
# Run code + rodata from PSRAM so a flash-cache miss can't starve the RGB
# bounce buffer. Bench-tested: this turned the ST7262 "sync
# slip" from stuck-until-power-cycle into self-recovering.
CONFIG_SPIRAM_XIP_FROM_PSRAM=y

# Keep the RGB scan-out alive through flash writes and resync on VSYNC
CONFIG_LCD_RGB_ISR_IRAM_SAFE=y
CONFIG_LCD_RGB_RESTART_IN_VSYNC=y

# Power management: DFS + automatic light sleep (used by the sleep tests)
CONFIG_PM_ENABLE=y
CONFIG_PM_SLP_IRAM_OPT=y
CONFIG_PM_RTOS_IDLE_OPT=y
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_ESP_WIFI_SLP_IRAM_OPT=y
# Wi-Fi config lives in RAM: no NVS flash writes while the panel scans
CONFIG_ESP_WIFI_NVS_ENABLED=n

# LVGL 9: heap from the system allocator (lands in PSRAM), larger fonts
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_THEME_DEFAULT_DARK=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_40=y
